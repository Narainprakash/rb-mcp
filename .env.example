# X (Twitter) API v2 Credentials
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"

# Discord Webhook
DISCORD_WEBHOOK_URL="your_discord_webhook_url"

# Robinhood Agentic MCP Credentials (if using standalone auth later)
ROBINHOOD_USERNAME=""
ROBINHOOD_PASSWORD=""
ROBINHOOD_MFA_CODE=""

# NOTE: The OpenRouter API key for the Nous Hermes Agent goes in a SEPARATE
# file at ~/.hermes/.env (NOT here). See Section 8.1 of specs.md for details.
# OPENROUTER_API_KEY=sk-or-your-key-here  (store in ~/.hermes/.env)
