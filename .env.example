# X (Twitter) API v2 Credentials
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"
TWITTER_API_KEY="your_api_key_here"
TWITTER_API_SECRET="your_api_secret_here"
TWITTER_ACCESS_TOKEN="your_access_token_here"
TWITTER_ACCESS_TOKEN_SECRET="your_access_token_secret_here"

# Discord Webhook
DISCORD_WEBHOOK_URL="your_discord_webhook_url"

# Dashboard Flask session signing key (alternative to config.yaml -> dashboard.secret_key)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=""

# Robinhood Agentic MCP Credentials (if using standalone auth later)
ROBINHOOD_USERNAME=""
ROBINHOOD_PASSWORD=""
ROBINHOOD_MFA_CODE=""

# NOTE: The OpenRouter API key for the Nous Hermes Agent goes in a SEPARATE
# file at ~/.hermes/.env (NOT here). See Section 8.1 of specs.md for details.
# OPENROUTER_API_KEY=sk-or-your-key-here  (store in ~/.hermes/.env)
