# ==========================================
# Hermes Config: Polling Settings
# ==========================================
polling:
  timezone: "America/New_York"           # The timezone for polling and cutoff logic. Options trading follows NY time.
  windows:                               # Custom polling intervals based on time of day (24-hour ET)
    - {start: "09:10", end: "09:40", interval_sec: 15}  # Fast polling during market open
    - {start: "15:30", end: "16:15", interval_sec: 15}  # Fast polling during market close
    - {start: "09:00", end: "09:10", interval_sec: 120} # Slow polling pre-market
    - {start: "09:40", end: "15:30", interval_sec: 120} # Slow polling mid-day
  target_account: "kttechprivate"        # The Twitter/X handle to poll for signals (without the @)
  monthly_api_call_ceiling: 10000        # Safeguard: Hard limit on Twitter API calls per month to avoid overage charges
  skip_market_holidays: true             # If true, the bot will sleep during weekends and NYSE holidays

# ==========================================
# Hermes Config: Decision Engine Settings
# ==========================================
decision:
  price_tolerance_pct: 10                # Max acceptable markup percentage from the alerted entry price for a market buy
  take_profit_pct: 20                    # Target profit percentage for the automated limit sell order (e.g. 20%)
  limit_buy_discount_pct: 20             # Discount target percentage for a limit buy if the live ask is currently lower than the alert
  contracts_per_signal: 1                # Number of contracts to buy per alert (for both BTO and ADD)
  max_open_positions: 10                 # Hard cap on the number of simultaneous active option positions
  per_trade_max_spend_usd: 500           # Maximum dollar amount allowed for a single order
  max_spend_per_position_usd: 1000       # Maximum dollar exposure allowed per contract (protects against multiple ADD signals)
  max_daily_spend_usd: 5000              # Maximum total dollars deployed in a single calendar day

# ==========================================
# Hermes Config: Execution Engine Settings
# ==========================================
execution:
  paper_mode: true                       # If true, simulates trades and fills. If false, connects to Robinhood MCP for live trading.
  robinhood_account_id: "<your_agentic_account_id>"  # Your specific Robinhood Agentic Account ID for live trading
  error_circuit_breaker_count: 3         # If the Robinhood API returns this many consecutive errors, the bot automatically engages the kill switch
  zero_dte_market_sell_cutoff: "15:50"   # Time (ET) to automatically market-sell open 0DTE limit sell orders to prevent worthless expiration

# ==========================================
# Hermes Config: Notification & Alerting
# ==========================================
notifications:
  events_enabled:                        # List of event types you want the bot to notify you about via Discord/WhatsApp
    - alert
    - add
    - review
    - executed
    - paper
    - skipped
    - limit_buy_placed
    - limit_sell_placed
    - limit_sell_filled
    - kill_switch
    - error
  whatsapp_trade_targets:                # Contacts to receive trade receipts and errors
    - "whatsapp"
  whatsapp_forward_targets:              # Contacts to receive the forwarded raw text of the #ALERT tweet
    - "whatsapp"

# ==========================================
# Hermes Config: Web Dashboard Settings
# ==========================================
dashboard:
  bind_address: "127.0.0.1"              # Local IP the read-only web dashboard runs on
  port: 8420                             # Port for the web dashboard

# ==========================================
# Hermes Config: Telegram Gateway Settings
# ==========================================
gateway:
  authorized_telegram_user: "Prakash_1803"  # Only this Telegram username is allowed to issue conversational commands to the bot

# ==========================================
# Hermes Config: Daily Summary Settings
# ==========================================
summary:
  enabled: true                          # If true, pushes an end-of-day summary message
  time: "16:30"                          # Time (ET) to calculate and send the daily summary
  targets:                               # Contacts to receive the daily summary report
    - "whatsapp"
